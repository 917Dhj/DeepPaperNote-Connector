{
	"name": "DeepPaperNote Connector",
	"manifest_version": 3,
	"version": "AUTOFILLED",
	"description": "Archive research PDFs into a DeepPaperNote Obsidian vault",
	"default_locale": "en",
	"action": {
		"default_icon": {
			"16": "Icon-16.png",
			"32": "Icon-32.png",
			"48": "Icon-64.png"
		},
		"default_title": "Save to DeepPaperNote"
	},
	"host_permissions": ["http://127.0.0.1/*", "https://repo.zotero.org/*", "https://api.zotero.org/*", "http://*/*", "https://*/*"],
	"permissions": ["tabs", "contextMenus", "cookies", "scripting", "offscreen",
		"webRequest", "declarativeNetRequest", "webNavigation", "storage", "nativeMessaging"],
	"declarative_net_request": {
		"rule_resources": [{
			"id": "styleIntercept",
			"enabled": true,
			"path": "styleInterceptRules.json"
		}]
	},
	"optional_permissions": ["management", "clipboardWrite"],
	"background": {
		"service_worker": "background-worker.js"
	},
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"run_at": "document_start",
			"js": [/*INJECT SCRIPTS*/]
		}
	],
	"sandbox": {
		"pages": ["offscreen/offscreenSandbox.html"]
	},
	"web_accessible_resources": [{
		"resources": [
			"images/*",
			"progressWindow/progressWindow.html",
			"modalPrompt/modalPrompt.html",
			"confirm/confirm.html",
			"test/data/journalArticle-single.html",
			"browserAttachmentMonitor/browserAttachmentMonitor.html",
			"lib/SingleFile/single-file-hooks-frames.js",
			"inject/pageSaving.js",
			"translateWeb.js",
			"itemSaver.js"
		],
		"matches": ["http://*/*", "https://*/*"]
	}],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"homepage_url": "https://github.com/917Dhj/DeepPaperNote-Connector",
	"icons": {
		"16": "Icon-16.png",
		"32": "Icon-32.png",
		"64": "Icon-64.png",
		"128": "Icon-128.png"
	},
	"options_ui": {
		"page": "deeppapernote-options.html",
		"open_in_tab": true
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+S"
			}
		}
	},
	"minimum_chrome_version": "88"
}
